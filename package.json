{
  "name": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "tsx --conditions=development ./server/index.ts",
    "dev:mq": "tsx watch ./mq/index.ts",
    "start:server": "node ./dist/server-index.js",
    "start:mq": "node ./dist/mq-index.js",
    "build": "run-p build:*",
    "build:rr": "react-router build",
    "build:esbuild": "tsx ./esbuild.config.ts",
    "clean": "run-p clean:*",
    "clean:rr": "rm -rf ./build",
    "clean:esbuild": "rm -rf ./dist",
    "typecheck": "react-router typegen && tsc",
    "typesync:run": "typesync",
    "typesync:ci": "typesync --dry=fail",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "NODE_ENV=test vitest run",
    "db:up": "tsx tasks/db.ts up && tsx tasks/dump-schema.ts",
    "db:down": "tsx tasks/db.ts down && tsx tasks/dump-schema.ts",
    "db:create": "tsx tasks/db.ts create",
    "db:latest": "tsx tasks/db.ts latest && tsx tasks/dump-schema.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@libsql/kysely-libsql": "^0.4.1",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "bullmq": "^6.3.8",
    "classnames": "^2.5.1",
    "close-with-grace": "^2.5.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "intl-parse-accept-language": "^1.0.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.2",
    "kysely": "^0.29.6",
    "kysely-migration-cli": "^0.4.2",
    "morgan": "^1.12.1",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "remix-utils": "^10.0.0",
    "resend": "^6.28.1",
    "ulidx": "^2.4.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@picocss/pico": "^2.1.1",
    "@react-router/dev": "^8.4.0",
    "@react-router/remix-routes-option-adapter": "^8.4.0",
    "@types/compression": "~1.8.1",
    "@types/express": "~5.0.6",
    "@types/morgan": "~1.9.10",
    "@types/qs": "~6.15.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "remix-flat-routes": "^0.8.5",
    "sscg": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typesync": "^0.14.3",
    "vite": "^8.3.0",
    "vite-plugin-environment": "^1.1.4",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
