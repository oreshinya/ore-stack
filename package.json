{
  "name": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "tsx --conditions=development ./server/index.ts",
    "dev:mq": "tsx watch ./mq/index.ts",
    "start:server": "node ./dist/server-index.js",
    "start:mq": "node ./dist/mq-index.js",
    "build": "run-p build:*",
    "build:rr": "react-router build",
    "build:esbuild": "tsx ./esbuild.config.ts",
    "clean": "run-p clean:*",
    "clean:rr": "rm -rf ./build",
    "clean:esbuild": "rm -rf ./dist",
    "typecheck": "react-router typegen && tsc",
    "typesync:run": "typesync",
    "typesync:ci": "typesync --dry=fail",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "NODE_ENV=test vitest run",
    "db:up": "tsx tasks/db.ts up && tsx tasks/dump-schema.ts",
    "db:down": "tsx tasks/db.ts down && tsx tasks/dump-schema.ts",
    "db:create": "tsx tasks/db.ts create",
    "db:latest": "tsx tasks/db.ts latest && tsx tasks/dump-schema.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@libsql/kysely-libsql": "^0.4.1",
    "@react-router/express": "^8.2.0",
    "@react-router/node": "^8.2.0",
    "@react-router/serve": "^8.2.0",
    "bullmq": "^5.80.10",
    "classnames": "^2.5.1",
    "close-with-grace": "^2.5.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "intl-parse-accept-language": "^1.0.0",
    "isbot": "^5.2.1",
    "kysely": "^0.29.3",
    "kysely-migration-cli": "^0.4.2",
    "morgan": "^1.11.0",
    "qs": "^6.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "remix-utils": "^10.0.0",
    "resend": "^6.18.0",
    "ulidx": "^2.4.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@picocss/pico": "^2.1.1",
    "@react-router/dev": "^8.2.0",
    "@react-router/remix-routes-option-adapter": "^8.2.0",
    "@types/compression": "~1.8.1",
    "@types/express": "~5.0.6",
    "@types/morgan": "~1.9.10",
    "@types/qs": "~6.15.1",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "remix-flat-routes": "^0.8.5",
    "sscg": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typesync": "^0.14.3",
    "vite": "^8.1.5",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
