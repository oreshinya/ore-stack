{
  "name": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "node --conditions=development --import tsx ./server/index.ts",
    "dev:mq": "node --watch --import tsx ./mq/index.ts",
    "start:server": "node ./dist/server-index.js",
    "start:mq": "node ./dist/mq-index.js",
    "build": "run-p build:*",
    "build:rr": "react-router build",
    "build:esbuild": "node --import tsx ./esbuild.config.ts",
    "clean": "run-p clean:*",
    "clean:rr": "rm -rf ./build",
    "clean:esbuild": "rm -rf ./dist",
    "typecheck": "react-router typegen && tsc",
    "typesync:run": "typesync",
    "typesync:ci": "typesync --dry=fail",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "NODE_ENV=test vitest run",
    "db:up": "node --import tsx tasks/db.ts up && node --import tsx tasks/dump-schema.ts",
    "db:down": "node --import tsx tasks/db.ts down && node --import tsx tasks/dump-schema.ts",
    "db:create": "node --import tsx tasks/db.ts create",
    "db:latest": "node --import tsx tasks/db.ts latest && node --import tsx tasks/dump-schema.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@libsql/kysely-libsql": "^0.4.1",
    "@react-router/express": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "bullmq": "^6.4.0",
    "classnames": "^2.5.1",
    "close-with-grace": "^2.5.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "intl-parse-accept-language": "^1.0.0",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.2",
    "kysely": "^0.29.7",
    "kysely-migration-cli": "^0.4.2",
    "morgan": "^1.12.1",
    "qs": "^6.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "remix-utils": "^10.0.1",
    "resend": "^6.34.1",
    "ulidx": "^2.4.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@picocss/pico": "^2.1.1",
    "@react-router/dev": "^8.5.0",
    "@react-router/remix-routes-option-adapter": "^8.5.0",
    "@types/compression": "~1.8.1",
    "@types/express": "~5.0.6",
    "@types/morgan": "~1.9.10",
    "@types/qs": "~6.15.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "remix-flat-routes": "^0.8.5",
    "sscg": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typesync": "^0.14.3",
    "vite": "^8.3.5",
    "vite-plugin-environment": "^1.1.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
