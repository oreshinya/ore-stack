{
  "name": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:server": "tsx --conditions=development ./server/index.ts",
    "start:server": "node ./dist/server-index.js",
    "build": "run-p build:*",
    "build:rr": "react-router build",
    "build:esbuild": "tsx ./esbuild.config.ts",
    "clean": "run-p clean:*",
    "clean:rr": "rm -rf ./build",
    "clean:dist": "rm -rf ./dist",
    "typecheck": "react-router typegen && tsc",
    "typesync:run": "typesync",
    "typesync:ci": "typesync --dry=fail",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "NODE_ENV=test DB_URL=:memory: vitest run",
    "db:up": "tsx tasks/db.ts up && tsx tasks/dump-schema.ts",
    "db:down": "tsx tasks/db.ts down && tsx tasks/dump-schema.ts",
    "db:create": "tsx tasks/db.ts create",
    "db:latest": "tsx tasks/db.ts latest && tsx tasks/dump-schema.ts"
  },
  "dependencies": {
    "@libsql/kysely-libsql": "^0.4.1",
    "@react-router/express": "^8.0.1",
    "@react-router/node": "^8.0.1",
    "@react-router/serve": "^8.0.1",
    "classnames": "^2.5.1",
    "close-with-grace": "^2.5.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "isbot": "^5.1.43",
    "kysely": "^0.29.2",
    "kysely-migration-cli": "^0.4.2",
    "morgan": "^1.11.0",
    "qs": "^6.15.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "remix-utils": "^10.0.0",
    "ulidx": "^2.4.1",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@picocss/pico": "^2.1.1",
    "@react-router/dev": "^8.0.1",
    "@react-router/remix-routes-option-adapter": "^8.0.1",
    "@types/compression": "~1.8.1",
    "@types/express": "~5.0.6",
    "@types/morgan": "~1.9.10",
    "@types/qs": "~6.15.1",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "remix-flat-routes": "^0.8.5",
    "sscg": "^1.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typesync": "^0.14.3",
    "vite": "^8.0.16",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
